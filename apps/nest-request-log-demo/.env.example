PORT=3000
REQUEST_LOG_PROJECT_ID=nest-demo

# --- Postgres: use ONE of the two options below ---

# Option A: single URI (password must be URL-encoded, e.g. & -> %26)
# PG_CONNECTION=postgresql://user:pass@host:5432/dbname?sslmode=require

# Option B: discrete vars (demo builds URI if PG_CONNECTION is unset) — typical for Azure
POSTGRES_HOST=your-server.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=your_database
# PEM path: absolute, or relative to process cwd when the app starts (repo / app folder)
POSTGRES_CERT_PATH=MicrosoftRSARootCertificateAuthority.crt.pem
POSTGRES_SSLMODE=require
# Set true to silence pg v8 SSL mode deprecation warning (libpq-compatible semantics)
# POSTGRES_SSL_LIBPQ_COMPAT=true

# Prepends to URI db name only: {prefix}{POSTGRES_DATABASE}. Must exist as one DB name.
# REQUEST_LOG_TABLE_PREFIX=

REQUEST_LOG_ACTIVITY_UI_ENABLED=true
REQUEST_LOG_ACTIVITY_UI_USERNAME=demo
REQUEST_LOG_ACTIVITY_UI_PASSWORD=demo
REQUEST_LOG_CAPTURE_THIRD_PARTY_ENABLED=true
REQUEST_LOG_CAPTURE_DB_POSTGRES_ENABLED=true
# REQUEST_LOG_CAPTURE_THIRD_PARTY_REQUEST_BODY=true
# REQUEST_LOG_CAPTURE_THIRD_PARTY_RESPONSE_BODY=true
# REQUEST_LOG_CAPTURE_THIRD_PARTY_MAX_BODY=8192
# REQUEST_LOG_CAPTURE_DB_POSTGRES_QUERY_TEXT=true
# REQUEST_LOG_CAPTURE_DB_POSTGRES_MAX_QUERY=4096
# REQUEST_LOG_EXCLUDE_PATH_PREFIXES=/request-logs,/examples/no-capture
# Demo endpoint override for outbound API sample
# DEMO_THIRD_PARTY_URL=https://jsonplaceholder.typicode.com/todos/1

# Optional: headers read for each captured request (stored as user_id / customer_id)
# REQUEST_LOG_USER_ID_HEADER=x-user-id
# REQUEST_LOG_CUSTOMER_ID_HEADER=x-customer-id

REDIS_ENABLED=false
# Option A: single URL
# REDIS_URL=redis://localhost:6379
# Option B: discrete (used when REDIS_URL is unset; TLS + 6380 typical for Azure Cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_TTL=36000
# ; Azure example (non-TLS line commented — use one block only)
# ; REDIS_HOST=your-cache.redis.cache.windows.net
# ; REDIS_PORT=6380
# ; REDIS_PASSWORD=your-access-key
# ; REDIS_TLS=true

AZURE_BLOB_ENABLED=false
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_S3_CONNECTION=
BLOB_CONTAINER=
