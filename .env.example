# --- @catrn-sdk/request-logging-sdk (Express in-process) ---
REQUEST_LOG_PROJECT_ID=
PG_CONNECTION=
# Table prefix: rows go to {prefix}_requests (empty = table "requests"). Run DDL: getRequestsTableDdl(prefix) or sql/001_requests.sql
# REQUEST_LOG_TABLE_PREFIX=
REQUEST_LOG_ACTIVITY_UI_ENABLED=false
# REQUEST_LOG_ACTIVITY_UI_USERNAME=
# REQUEST_LOG_ACTIVITY_UI_PASSWORD=   # both required together for UI login; sessionStorage per tab
AZURE_BLOB_ENABLED=false
AZURE_BLOB_CONNECTION_STRING=
# AZURE_S3_CONNECTION=
BLOB_CONTAINER=
REQUEST_LOG_CAPTURE_HEADERS=true
REQUEST_LOG_CAPTURE_BODY=true
REQUEST_LOG_MAX_BODY=65536
REDIS_ENABLED=false
# Use REDIS_URL or (when unset) REDIS_HOST + REDIS_PORT + REDIS_PASSWORD + REDIS_TLS
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_TTL=36000
REQUEST_LOG_QUEUE_MAX=1000
REQUEST_LOG_DB_RETRIES=3
REQUEST_LOG_ERROR_THROTTLE_MS=5000

# Optional: distributed worker / log-api (see docs/observability-platform-sa-plan.md)
# LOG_DB_HOST=...
# AZURE_STORAGE_ACCOUNT_KEY=  # SAS signing for log viewer API
